# Скопируйте в .env (в папку, откуда запускаете textuniq) и впишите свой ключ.
# API-ключ сервисного аккаунта Yandex Cloud с ролью ai.translate.user
# и областью действия yc.ai.translate.execute (как получить — в README).
YANDEX_API_KEY=

# Нужен только при работе от пользовательского аккаунта (IAM-токен),
# для API-ключа сервисного аккаунта оставьте пустым.
YANDEX_FOLDER_ID=
